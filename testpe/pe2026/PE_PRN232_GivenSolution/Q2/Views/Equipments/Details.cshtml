@model EquipmentDto
<h2>@Model.Name</h2>

<ul>
    <li>Category: @Model.Category</li>
    <li>Price/Day: @Model.PricePerDay</li>
    <li>Deposit Fee: @Model.DepositFee</li>
    <li>Stock Quantity: @Model.StockQuantity</li>
    <li>Uploader Email: @Model.UploaderEmail</li>
</ul>

@{
    var role = Context.Session.GetString("Role");
}
@if (role == "customer")
{
    <a asp-action="Rent" asp-route-id="@Model.EquipmentId">Rent Now</a>
}

<p><a asp-action="Index">Back to list</a></p>
